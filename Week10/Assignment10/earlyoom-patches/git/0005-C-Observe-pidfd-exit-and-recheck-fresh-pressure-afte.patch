From: Course work <course-work@example.invalid>
Date: Tue, 24 Nov 2026 00:00:00 +0900
Subject: [PATCH 5/5] C: Observe pidfd exit and recheck fresh pressure after
 cooldown

---
 lab_earlyoom.c | 108 ++++++++++++++++++++++++++++---------------------
 1 file changed, 61 insertions(+), 47 deletions(-)

diff --git a/lab_earlyoom.c b/lab_earlyoom.c
index 9bfc09d..3599cf8 100644
--- a/lab_earlyoom.c
+++ b/lab_earlyoom.c
@@ -199,29 +199,30 @@ static int fresh(trigger *t, int n, unsigned long long *previous, double elapsed
         return -1;
 
     char line[256];
-    unsigned long long s = 0, u = 0;
+    unsigned long long values[2] = {0};
+    int seen[2] = {0};
 
     while (fgets(line, sizeof line, f)) {
-        unsigned long long v;
-        if (sscanf(line, "some %*s %*s %*s total=%llu", &v) == 1)
-            s = v;
-
-        if (sscanf(line, "full %*s %*s %*s total=%llu", &v) == 1)
-            u = v;
+        if (sscanf(line, "some %*s %*s %*s total=%llu", &values[0]) == 1)
+            seen[0] = 1;
+        if (sscanf(line, "full %*s %*s %*s total=%llu", &values[1]) == 1)
+            seen[1] = 1;
     }
-
+    int error = ferror(f);
     fclose(f);
     int active = 0;
 
     for (int i = 0; i < n; i++) {
-        unsigned long long v = !strcmp(t[i].kind, "some") ? s : u;
+        int metric = !strcmp(t[i].kind, "full");
+        if (error || !seen[metric])
+            return -1;
+        unsigned long long v = values[metric];
         if (v < previous[i])
             active = -1;
         else if (active >= 0 && v - previous[i] >= (double)t[i].stall * elapsed * 1e6 / t[i].window)
             active = 1;
         previous[i] = v;
     }
-
     return active;
 }
 
@@ -360,38 +361,53 @@ int main(int argc, char **argv) {
         if (active[i].window / 1e6 > window)
             window = active[i].window / 1e6;
     unsigned long long prev[8] = {0};
-    fresh(active, valid, prev, window);
+    int baseline_ok = fresh(active, valid, prev, window) >= 0;
     double end = now() + seconds, next = 0, last = now();
     int level = 0, clean = 0, persistent = 0;
     int floors[] = {900, 700, 200, 0};
     int status = 0;
 
     while (!stopping && now() < end) {
-        poll(pf, (nfds_t)np, 100);
+        if (poll(pf, (nfds_t)np, 100) < 0) {
+            if (errno == EINTR)
+                continue;
+            perror("poll");
+            status = 1;
+            break;
+        }
         int event = 0;
         for (int i = 0; i < np; i++) {
             if (pf[i].revents & POLLPRI)
                 event = 1;
 
-            if (pf[i].revents & (POLLERR | POLLNVAL)) {
+            if (pf[i].revents & (POLLERR | POLLHUP | POLLNVAL)) {
                 puts("PSI descriptor error; stopping");
                 status = 1;
                 stopping = 1;
             }
         }
 
-        if (now() < next)
+        if (stopping || now() < next)
             continue;
+        if (event)
+            printf("t=%.6f event=psi_trigger\n", now());
 
         meminfo_t m = parse_meminfo();
         int low = amount(m, mem, swap), critical = amount(m, killmem, killswap);
 
+        if (!baseline_ok && now() >= last) {
+            baseline_ok = fresh(active, valid, prev, window) >= 0;
+            last = now();
+            event = 0;
+        }
         if (now() - last >= window) {
             int f = fresh(active, valid, prev, now() - last);
             last = now();
-            persistent = f > 0;
+            int usable = baseline_ok && f >= 0;
+            baseline_ok = f >= 0;
+            persistent = usable && f > 0;
 
-            if (f == 0 && !low) {
+            if (usable && valid == nt && f == 0 && !low) {
                 if (++clean >= 2) {
                     level = 0;
                     persistent = 0;
@@ -451,7 +467,11 @@ int main(int argc, char **argv) {
             continue;
         }
 
-        int fd = -1, sig = critical ? SIGKILL : SIGTERM;
+        int fd = -1;
+        int sig = critical ? SIGKILL : SIGTERM;
+        unsigned long long grace_base[8] = {0};
+        double grace_start = now();
+        int grace_baseline_ok = fresh(active, valid, grace_base, 0) >= 0;
         if (signal_record(&rs[k], sig, &fd)) {
             printf("t=%.6f event=signal_error errno=%d\n", now(), errno);
             if (fd >= 0)
@@ -475,15 +495,16 @@ int main(int argc, char **argv) {
         if (!exited && sig == SIGTERM && !stopping) {
             meminfo_t cur = parse_meminfo();
             int pressured = amount(cur, mem, swap);
-            if (valid) {
-                int f = fresh(active, valid, prev, now() - last);
-                last = now();
-                pressured |= f > 0;
-            }
+            double elapsed = now() - grace_start;
+            if (valid && grace_baseline_ok && elapsed >= window)
+                pressured |= fresh(active, valid, grace_base, elapsed) > 0;
 
             if (pressured) {
-                if (!signal_record(&rs[k], SIGKILL, &fd))
+                if (!signal_record(&rs[k], SIGKILL, &fd)) {
+                    sig = SIGKILL;
                     printf("t=%.6f event=signal pid=%d signal=9 via=pidfd\n", now(), rs[k].c.pid);
+                } else
+                    printf("t=%.6f event=signal_error pid=%d errno=%d\n", now(), rs[k].c.pid, errno);
             } else
                 printf("t=%.6f event=cancel_escalation pid=%d\n", now(), rs[k].c.pid);
         }
@@ -497,32 +518,25 @@ int main(int argc, char **argv) {
             exited = 1;
         printf("t=%.6f event=%s pid=%d\n", now(), exited ? "exit_observed" : "exit_pending",
                rs[k].c.pid);
-        close(fd);
-        next = now() + cool;
-        /* No second victim while the previous registered identity is alive. */
-        if (!exited) {
-            while (!stopping && now() < end && ticks(rs[k].c.pid) == rs[k].start) {
-                char p[80], s[4096];
-                snprintf(p, sizeof p, "/proc/%d/stat", rs[k].c.pid);
-                FILE *f = fopen(p, "r");
-                int zombie = 0;
-
-                if (f) {
-                    if (fgets(s, sizeof s, f)) {
-                        char *q = strrchr(s, ')');
-                        zombie = q && q[2] == 'Z';
-                    }
-
-                    fclose(f);
-                }
-
-                if (zombie)
-                    break;
-
-                struct timespec wait = {0, 100000000};
-                nanosleep(&wait, NULL);
+        /* Keep the pidfd alive until confirmed exit or the run deadline. */
+        while (!exited && !stopping && now() < end) {
+            int rc = poll(&exitfd, 1, 100);
+            if (rc > 0 && (exitfd.revents & (POLLIN | POLLHUP))) {
+                exited = 1;
+                printf("t=%.6f event=exit_observed pid=%d\n", now(), rs[k].c.pid);
+            } else if ((rc < 0 && errno != EINTR) || (rc > 0 && (exitfd.revents & (POLLERR | POLLNVAL)))) {
+                puts("pidfd exit observation failed; stopping");
+                status = 1;
+                stopping = 1;
             }
         }
+        close(fd);
+        next = now() + cool;
+        /* Start a new PSI interval only after cooldown, dropping pending events. */
+        last = next;
+        baseline_ok = 0;
+        persistent = 0;
+        clean = 0;
     }
 
     for (int i = 0; i < nt; i++)
